import "mgmt-ssh/"
import "mgmt-keys/"

$accepted_env = "LANG LC_* GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL"
$agent_forwarding = "yes"
$pass_auth = "no"
$permit_root = "prohibit-password"
$port = 22

$ssh_config_values =  struct {
	accepted_env => $accepted_env,
	agent_forwarding => $agent_forwarding,
	pass_auth => $pass_auth,
	permit_root => $permit_root,
	port => $port,
}

include ssh.ssh($ssh_config_values)
include keys.keys("oalshuha", "ssh-ed25519 XXX oalshuha@Loki")
include keys.keys("pgl", "ssh-ed25519 XXX pgl@lpc23")
include keys.keys("james", "ssh-rsa XXX james@miaplaza")

