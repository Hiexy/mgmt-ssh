import "mgmt-ssh/"
import "mgmt-keys/"

$accepted_env = "LANG LC_* GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL"
$agent_forwarding = "yes"
$pass_auth = "no"
$permit_root = "prohibit-password"
$port = 22

$ssh_config_values =  struct {
	accepted_env => $accepted_env,
	agent_forwarding => $agent_forwarding,
	pass_auth => $pass_auth,
	permit_root => $permit_root,
	port => $port,
}
$ssh_config_name = "miaplaza"

include ssh.ssh($ssh_config_name, $ssh_config_values)
include keys.keys("oalshuha", "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAI6KU1Ud9PCUlqgiQonDDezdzyGkAKVlp9Hw8TMJEFR oalshuha@Loki")
include keys.keys("pgl", "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIALWn0y66ZTtzzqqBk7DKXkkE2jRhE9qWm9ePshQ4/z1 pgl@framework")
include keys.keys("james", "ssh-rsa  james@miaplaza")


