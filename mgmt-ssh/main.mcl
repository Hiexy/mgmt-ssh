import "deploy"
import "os"

$family = os.family()

$names = {
	"debian" => {
		"pkg" => "openssh-server",
		"svc" => "sshd",
	},
	"archlinux" => {
		"pkg" => "openssh-server",
		"svc" => "sshd",
	},
	"redhat" => {
		"pkg" => "openssh-server",
		"svc" => "sshd",
	},
	"" => {
		"pkg" => "",
		"svc" => "",
	},
}

$ssh_name map{str: str} = $names[$family]

$package str = $ssh_name["pkg"]
$service str = $ssh_name["svc"]

class ssh($config_name, $config_values) {
	# Install openssh package
	pkg "${package}" {
		state => "installed",
	}

	file "/etc/ssh/" {
		state => $const.res.file.state.exists,
	}

	file "/etc/ssh/sshd_config.d/" {
		state => $const.res.file.state.exists,
		purge => true,
		recurse => true,
	}

	$sshd_config = deploy.readfile("/files/sshd_config.tpl")
	file "/etc/ssh/sshd_config.d/${config_name}.conf" {
		state => $const.res.file.state.exists,
		content => template($sshd_config, $config_values),
	}

	# Start ssh service
	svc "${service}" {
		state => "running",
	}
}
